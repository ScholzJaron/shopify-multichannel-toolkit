# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- Shopify Admin API ---
# Your store handle. Either "your-store" or "your-store.myshopify.com".
SHOPIFY_STORE=
# Custom app Admin API access token (shpat_...).
# Scopes depend on what you run: read_products / write_products for the SEO and
# tagging scripts, read_files / write_files for media upload.
SHOPIFY_ADMIN_TOKEN=
# Admin API version. Bump deliberately; Shopify deprecates on a schedule.
SHOPIFY_API_VERSION=2025-07

# --- IndexNow ---
# 8-128 hex characters. Generate with: openssl rand -hex 16
# Must also be hosted at INDEXNOW_KEY_URL as plain text.
INDEXNOW_KEY=
# Bare host, no scheme. Example: www.example.com
INDEXNOW_HOST=
# Defaults to https://$INDEXNOW_HOST/$INDEXNOW_KEY.txt if unset.
INDEXNOW_KEY_URL=
# Defaults to https://$INDEXNOW_HOST/sitemap.xml if unset.
SITEMAP_URL=
